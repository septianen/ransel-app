<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone (Android 12+): the session is encrypted with a Keystore key that does not
     travel, and the local database comes back from the server after sign-in. A restored copy broke sign-in (401) and
     crashed Room after its version was reset to 1 (3 Nov 2026). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
