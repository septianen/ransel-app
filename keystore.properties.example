# Copy to keystore.properties (git-ignored) to sign release builds. Paths are relative to the repo root.
# Create the key once and keep it (and its passwords) outside git, e.g. in a password manager:
#   keytool -genkeypair -v -keystore ransel-release.jks -alias ransel -keyalg RSA -keysize 4096 -validity 10000
# CI: set RANSEL_KEYSTORE_FILE, RANSEL_KEYSTORE_PASSWORD, RANSEL_KEY_ALIAS, RANSEL_KEY_PASSWORD instead.
storeFile=ransel-release.jks
storePassword=
keyAlias=ransel
keyPassword=
