PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/ransel
DATABASE_USER=ransel
DATABASE_PASSWORD=ransel
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# Auth: required (32+ chars) when APP_ENV=production; a fixed dev secret is used otherwise.
# APP_ENV=production
# JWT_SECRET=
# JWT_ISSUER=ransel
# Closed beta: no sign-up, one account created at startup (password: 8+ chars, a letter and a number).
# REGISTRATION_ENABLED=false
# SEED_USER_EMAIL=you@example.com
# SEED_USER_PASSWORD=
# SEED_USER_NAME=Test User
# More accounts, one variable: email|password|name;email|password|name  (no | or ; inside a password)
# SEED_USERS=
# Links in emails (password reset): <APP_BASE_URL>/reset-password?token=...
# APP_BASE_URL=https://ransel.mietek.tech
# Later phases:
# Explore AI (blank = the feature answers 503 AI_UNAVAILABLE)
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-3.8-flash   (check the id with models.list; see deploy/README.md)
# PLACES_API_KEY=
# EMAIL_API_KEY=
# APP_BASE_URL=https://ransel.app

# docker-compose.prod.yml only (on the VPS)
# SERVER_IMAGE=ghcr.io/<owner>/ransel-server:latest
# CORS_ORIGINS=https://ransel.app

# Invite links verification (served at /.well-known/...; both answer 404 until set)
# ANDROID_PACKAGE=app.ransel
# ANDROID_CERT_SHA256=AA:BB:...   (comma separated; Play App Signing + debug if needed)
# IOS_APP_IDS=TEAMID.app.ransel
